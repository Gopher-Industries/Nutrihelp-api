NODE_ENV=development
PORT=3000

# Frontend origins allowed by CORS. Use comma-separated values for multiple domains.
CORS_ORIGINS=http://localhost:3000

# Keep auto locally; set ENABLE_APP_HTTPS=false on PaaS providers that terminate HTTPS.
ENABLE_APP_HTTPS=auto

# Auth and database
JWT_SECRET=
JWT_TOKEN=
SUPABASE_URL=your_project_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_KEY=your_anon_key

# External AI service
AI_SERVER_BASE_URL=http://localhost:8000
AI_BASE_URL=http://localhost:8000/ai-model/medical-report

# AI-backed enrichment features
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=

# Optional storage/image providers
SUPABASE_STORAGE_URL=
UNSPLASH_ACCESS_KEY=

# Field encryption
ENCRYPTION_KEY=

# --- Support email (Contact Us) ---------------------------------------------
# Used by utils/emailService.js. If SMTP_HOST/SMTP_USER/SMTP_PASS are unset
# the service falls back to a no-op JSON transport (safe in dev/CI), so the
# Contact Us flow still returns 201 but no email is delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Inbox that receives Contact Us submissions (defaults to SMTP_USER if unset).
SUPPORT_EMAIL=
# Display "From" address (defaults to SUPPORT_EMAIL).
MAIL_FROM=
