PORT=3000
SUPABASE_URL=your_project_url
SUPABASE_KEY=your_anon_key
NODE_ENV=development

# --- Metrics scraping (NH-VULN-2026-014) ------------------------------------
# Static bearer token for GET /api/metrics. The endpoint is served to callers
# presenting this token and to nobody else. If this is left unset the endpoint
# returns 503 rather than becoming public, so a missing value cannot silently
# reopen the exposure. Generate with: openssl rand -base64 32
METRICS_TOKEN=

# --- Support email (Contact Us) ---------------------------------------------
# Used by utils/emailService.js. If SMTP_HOST/SMTP_USER/SMTP_PASS are unset
# the service falls back to a no-op JSON transport (safe in dev/CI), so the
# Contact Us flow still returns 201 but no email is delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Inbox that receives Contact Us submissions (defaults to SMTP_USER if unset).
SUPPORT_EMAIL=
# Display "From" address (defaults to SUPPORT_EMAIL).
MAIL_FROM=

# --- Ingredient nutrition (USDA FoodData Central) ---------------------------
# Used by services/nutritionSources when a recipe is saved. Free key from
# https://api.data.gov/signup/ (1,000 requests an hour). If this is unset the
# client falls back to DEMO_KEY, which allows about 10 requests an hour: fine
# for a quick look, too low for real use. A failed lookup never blocks a save.
USDA_API_KEY=
